# Copy to .env and fill in. NEVER commit a real key — .env is git-ignored.
# Get a free key: Google AI Studio -> Get API key (https://aistudio.google.com/)
GEMINI_API_KEY=
# Port for local runs. Cloud Run sets PORT automatically.
PORT=8080
# Max video upload in MB (test version). Full movies are 1-2 GB; keep 500 for tests.
MAX_UPLOAD_MB=500
# Optional: keep the uploaded source video after a successful render (1 = keep, for debugging).
KEEP_SOURCE=
# Optional: TTS voice name for gemini-2.5-flash-preview-tts (default Kore).
TTS_VOICE=Kore
